Options +FollowSymLinks
RewriteEngine On

###############################################
# Detect environment and set BASE folder
###############################################

# Localhost → /spencerkelly.firstbloc
RewriteCond %{HTTP_HOST} ^localhost [NC]
RewriteRule ^ - [E=BASE:/spencerkelly.firstbloc]

# Hostinger → /portfolio
RewriteCond %{HTTP_HOST} ^spencerkelly\.firstbloc\.com$ [NC]
RewriteRule ^ - [E=BASE:/portfolio]

###############################################
# Do NOT rewrite static assets
###############################################
RewriteCond %{REQUEST_URI} !^%{ENV:BASE}/dist/
RewriteCond %{REQUEST_URI} !^%{ENV:BASE}/assets/
RewriteCond %{REQUEST_URI} !^%{ENV:BASE}/images/

###############################################
# Only rewrite if file/folder does not exist
###############################################
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

###############################################
# Rewrite clean URLs into php folder
###############################################
RewriteRule ^(.+)$ %{ENV:BASE}/php/$1.php [QSA,L]
